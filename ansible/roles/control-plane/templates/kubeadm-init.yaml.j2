apiVersion: kubeadm.k8s.io/v1beta3
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: "{{ internal_ip }}"
  bindPort: 6443
nodeRegistration:
  kubeletArgs:
    - name: "node-ip"
      value: "{{ internal_ip }}"

---
apiVersion: kubeadm.k8s.io/v1beta3
kind: ClusterConfiguration
clusterName: diplom
kubernetesVersion: stable
networking:
  podSubnet: 10.244.0.0/16        # стандарт для flannel
  serviceSubnet: 10.96.0.0/12
apiServer:
  advertiseAddress: "{{ internal_ip }}"
  certSANs:
    - "{{ ansible_host }}"          # публичный (статический) IP мастера — kubeconfig идёт сюда
    - "{{ internal_ip }}"           # внутренний IP — для трафика внутри кластера
    - "kubernetes.default.svc"      # на всякий случай имена кластера
controllerManager: {}
scheduler: {}
etcd:
  local:
    dataDir: /var/lib/etcd

---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
failSwapOn: false
